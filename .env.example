# Copy this file to .env and fill in your real values. Never commit .env.

# Your domain/subdomain (e.g. order.yourdomain.com) — used by Caddy to
# request HTTPS automatically. Must match your DNS A record.
DOMAIN=order.yourdomain.com

PORT=3000

# Long random string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# Business display name (used in emails and PayNow QR merchant name)
BUSINESS_NAME=Fourth Avenue Coffee & Tea

# Gmail used to send order confirmation emails.
# You MUST use an "App Password", not your normal Gmail password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# PayNow details — whichever bank account/mobile number is PayNow-registered.
# PAYNOW_PROXY_TYPE must be "mobile" or "uen"
PAYNOW_PROXY_TYPE=mobile
PAYNOW_PROXY_VALUE=+6591234567
# Shown on the QR as the payee name. Keep it short — max 25 characters.
PAYNOW_MERCHANT_NAME=FACT

# Where the SQLite database file is stored (the docker volume mounts ./data here)
DB_PATH=./data/fact.db
